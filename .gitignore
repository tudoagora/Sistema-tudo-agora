# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# service_role baixado do dashboard do Supabase (vem em texto puro)
service-role*.json
*-service-role.json

# vercel
.vercel

# supabase CLI — estado local do stack (contém service_role e senha do banco)
supabase/.branches
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts
