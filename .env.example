# ============================================================
# TudoAgora — variáveis de ambiente
# Copie para .env.local e preencha. O .env.local nunca é
# commitado; este arquivo é a única versão que entra no repo.
#
# Local: `supabase start` + `supabase status` imprimem as chaves.
# Produção: projeto hospedado, em Settings → API.
# ============================================================

# ---------- As 4 variáveis que o app realmente lê ----------

# URL e anon key são públicas: vão para o bundle do navegador.
# A anon key NÃO é segredo — a segurança está no RLS do banco.
# O padrão abaixo é do stack local; em produção use a URL do
# projeto hospedado (https://<project-ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role ignora o RLS: acesso total ao banco. SÓ NO SERVIDOR.
# Nunca prefixar com NEXT_PUBLIC_, nunca logar, nunca commitar.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site, usada em e-mails e redirecionamentos.
# Em produção precisa bater com o domínio da Vercel.
NEXT_PUBLIC_SITE_URL=https://tudoagora.app.br

# ---------- Fase 2 — planejado, ainda sem código ----------
# Nada abaixo é lido por src/ no momento. Cadastre na Vercel só
# quando a feature correspondente existir.

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
# Pix direto (EFÍ/Gerencianet ou Pagar.me) — alternativa
PIX_PROVIDER=

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Migração do WordPress (scripts/)
# Application Password do WordPress (WP > Usuários > Perfil > Application Passwords)
WP_BASE_URL=https://tudoagora.app.br
WP_APP_PASSWORD=
